NODE_ENV=test
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/zeitgeist_test
BACKEND_COOKIE_SECRET=test-cookie-secret-value-with-enough-length
BACKEND_CORS_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=4
CSRF_HEADER_NAME=x-csrf-token

CONTENT_PROVIDER=local
PUBLISH_PROVIDER=local

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=zeitgeist
S3_SIGNED_URL_EXPIRES_SECONDS=300
UPLOAD_MAX_BYTES=26214400

RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=60
ANALYTICS_COOKIE_MAX_AGE_DAYS=365
