NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zeitgeist
BACKEND_COOKIE_SECRET=replace-with-a-long-random-secret-value
BACKEND_CORS_ORIGIN=http://localhost:3000
BACKEND_CORS_ORIGINS=
SESSION_TTL_HOURS=168
CSRF_HEADER_NAME=x-csrf-token

CONTENT_PROVIDER=local
PUBLISH_PROVIDER=local

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=zeitgeist
S3_SIGNED_URL_EXPIRES_SECONDS=300
UPLOAD_MAX_BYTES=26214400

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
ANALYTICS_COOKIE_MAX_AGE_DAYS=365
MAX_APPLAUSE_PER_USER_PER_ARTICLE=50

GHOST_CONTENT_API_URL=
GHOST_CONTENT_API_KEY=
GHOST_ADMIN_API_URL=
GHOST_ADMIN_API_KEY=

AUTH_APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
OAUTH_STATE_TTL_MINUTES=10
PREAUTH_TTL_MINUTES=10
TWO_FACTOR_CODE_TTL_MINUTES=10
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_MAX_RESENDS=4
TWO_FACTOR_RESEND_COOLDOWN_SECONDS=45
TWO_FACTOR_LOCK_MINUTES=15
TWO_FACTOR_CODE_SECRET=
EMAIL_PROVIDER=noop
EMAIL_FROM=
RESEND_API_KEY=
AUTH_EXPOSE_TEST_2FA_CODE=0
