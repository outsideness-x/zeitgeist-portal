NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
BACKEND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zeitgeist
BACKEND_COOKIE_SECRET=replace-with-a-long-random-secret-value
BACKEND_CORS_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168
CSRF_HEADER_NAME=x-csrf-token

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=zeitgeist
S3_SIGNED_URL_EXPIRES_SECONDS=300
UPLOAD_MAX_BYTES=26214400

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
